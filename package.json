{
  "name": "servos",
  "version": "0.1.0-rc.1",
  "private": true,
  "type": "module",
  "description": "App sin internet para traducir la Biblia con los recursos de Taller",
  "license": "MIT",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "dev": "vite --port 5190 --strictPort",
    "build": "tsc --noEmit -p . && vite build && node scripts/sitio.mjs",
    "sitio": "node scripts/sitio.mjs",
    "build:escritorio": "tsc --noEmit -p . && vite build --mode escritorio",
    "escritorio": "tauri dev",
    "escritorio:compilar": "tauri build",
    "build:telefono": "tsc --noEmit -p . && vite build --mode telefono && cap sync android",
    "telefono:abrir": "cap open android",
    "telefono:compilar": "npm run build:telefono && node scripts/android-build.mjs"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@tauri-apps/cli": "^2.12.3",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.0.0",
    "typescript": "^7.0.2",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/keyboard": "^8.0.6",
    "@dnd-kit/core": "^6.3.1",
    "@fontsource-variable/onest": "5.3.1",
    "@fontsource/charis-sil": "5.3.0",
    "@fontsource/gentium-plus": "5.3.0",
    "@tauri-apps/api": "^2.12.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
