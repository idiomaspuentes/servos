{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Servos",
  "version": "../package.json",
  "identifier": "org.idiomaspuentes.servos",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5190",
    "beforeBuildCommand": "npm run build:escritorio",
    "frontendDist": "../dist-escritorio"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Servos",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline' https://fonts.googleapis.com",
        "font-src": "'self' data: https://fonts.gstatic.com",
        "img-src": "'self' data: blob:",
        "media-src": "'self' data: blob:",
        "connect-src": "'self' ipc: http://ipc.localhost https://git.door43.org https://qa.door43.org http://localhost:8787 http://127.0.0.1:8787",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-src": "'none'"
      },
      "devCsp": null,
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Idiomas Puentes",
    "copyright": "Idiomas Puentes",
    "category": "Education",
    "shortDescription": "Para traducir en su idioma, en equipo, con o sin internet",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "fileAssociations": [
      {
        "ext": ["servos"],
        "name": "Servos.Compartido",
        "description": "Trabajo compartido de Servos",
        "role": "Editor",
        "mimeType": "application/json"
      }
    ],
    "windows": {
      "webviewInstallMode": { "type": "offlineInstaller", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish", "PortugueseBR", "English"],
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
